   "outputs": [],
   "source": [
    "import numpy as np\n",
    "L = np.array([[0.9],\n",
    "              [0.6],\n",
    "              [0.3]]) "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "5d976f72",
   "metadata": {},
   "outputs": [],
   "source": [
    "psi = 1.0 - np.sum(L**2, axis=1) "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "db462229",
   "metadata": {},
   "outputs": [],
   "source": [
    "R = L @ phi @ L.T + np.diag(psi)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "40976419",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "array([[1.  , 0.54, 0.27],\n",
       "       [0.54, 1.  , 0.18],\n",
       "       [0.27, 0.18, 1.  ]])"
      ]
     },
     "execution_count": 13,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "R"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "017a86dd",
   "metadata": {},
   "outputs": [],
   "source": [
    "W_reg = np.linalg.solve(R, L)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "e0b94d8e",
